# Copia este archivo como application-local.properties (está en .gitignore)
# y pon tus credenciales locales. NO subas application-local.properties.
# Si defines las variables de entorno DB_URL, DB_USER o DB_PASSWORD, tienen prioridad.
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/vestigia}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:tu-contraseña}
